@page "/plan/detailsplan/{PlanID:int}"
@inject AppForKairosAPIClient apiclient
@inject ILogger<DetailsPlan> logger
@using Microsoft.AspNetCore.Authorization
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]

<h3>Details Plan</h3>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}
else if (plan == null)
{
    <p>Loading plan details...</p>
}
else
{
    <div class="card mb-3">
        <div class="card-header">
            @* El Page Object busca planName aquí *@
            <h4 id="planName">@plan.PlanName</h4>
        </div>
        <div class="card-body">
            <table class="table table-borderless table-sm">
                <tr>
                    <th style="width: 200px;">Username</th>
                    <td id="nameSurname">@plan.UserName</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td id="planDescription">@plan.Description</td>
                </tr>
                <tr>
                    <th>Created Date</th>
                    @* Aseguramos el ID para la fecha *@
                    <td id="createdDate">@plan.DateCreated.ToString("dd/MM/yyyy HH:mm:ss")</td>
                </tr>
                <tr>
                    <th>Number of Weeks</th>
                    <td id="weeks">@plan.NumberOfWeeks</td>
                </tr>
                <tr>
                    <th>Health Issues</th>
                    <td id="healthIssues">@plan.HealthIssues</td>
                </tr>
                <tr>
                    <th>Total Price</th>
                    <td>@plan.TotalPrice.ToString("C")</td>
                </tr>
            </table>
        </div>
    </div>

    <h4>Selected Classes</h4>
    <div class="table-responsive">
        @* Añadido id="enrolledClasses" para que Selenium encuentre la tabla *@
        <table class="table table-striped" id="enrolledClasses">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Capacity</th>
                    <th scope="col">Price</th>
                    <th scope="col">Date</th>
                    <th scope="col">Types</th>
                </tr>
            </thead>
            <tbody>
                @if (plan.Classes != null)
                {
                    @foreach (var item in plan.Classes)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Capacity</td>
                            <td>@item.Price.ToString("C")</td>
                            <td>@item.Date.ToString("g")</td>
                            <td>
                                @if (item.ItemType != null)
                                {
                                    @string.Join(", ", item.ItemType)
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr class="table-primary">
                    <th scope="row" colspan="2" class="text-end">Total Price</th>
                    <td colspan="3">@plan.TotalPrice.ToString("C")</td>
                </tr>
            </tfoot>
        </table>
    </div>
}

@code {
    [Parameter]
    public int PlanID { get; set; }

    private PlanDetailDTO? plan;
    private string error = "";

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        error = "";
        string currentUserName = "";

        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user?.Identity is not null && user.Identity.IsAuthenticated)
            {
                currentUserName = user.Identity.Name ?? "";
            }
        }

        try
        {
            // Llamada a la API
            var response = await apiclient.GetPlanDetailsAsync(PlanID);

            // Si la API devuelve una lista, tomamos el primero. Si devuelve objeto, quitamos FirstOrDefault.
            plan = response?.FirstOrDefault();

            if (plan == null)
            {
                error = $"Plan with ID {PlanID} not found.";
            }
            else if (!string.IsNullOrEmpty(currentUserName) &&
                     !plan.UserName.Equals(currentUserName, StringComparison.OrdinalIgnoreCase))
            {
                error = "Error! You are not authorized to see this plan.";
                plan = null;
            }
        }
        catch (Exception ex)
        {
            logger.LogError($"Error: {ex.Message}");
            error = "An error occurred while loading plan details.";
        }
    }
}