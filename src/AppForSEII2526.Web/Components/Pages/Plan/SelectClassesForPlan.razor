@page "/plan/selectclassesforplan"
@inject AppForKairosAPIClient apiclient
@inject ILogger<SelectClassesForPlan> logger
@inject PlanStateContainer planState
@using AppForSEII2526.Web.API
@using AppForSEII2526.API.DTOs.ClassesDTOs

<h3>Select Classes For Plan</h3>
<div class="container-fluid">
    <div class="row" hidden="@hideErrors">
        <div class="alert alert-danger">
            Errors: @errors
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-9">
            <h4>Filters</h4>
            <div class="row g-3 align-items-center mb-4">
                <div class="col-auto">
                    <label class="col-form-label">Title/Type</label>
                </div>
                <div class="col-auto">
                    <input type="text" id="inputTitle" @bind="itemTypes" class="form-control" placeholder="Item Type">
                </div>

                <div class="col-auto">
                    <label class="col-form-label">Date</label>
                </div>
                <div class="col-auto">
                    <InputDate id="date" @bind-Value="@date" class="form-control" />
                </div>

                <div class="col-auto">
                    <label class="col-form-label">From</label>
                </div>
                <div class="col-auto">
                    <InputDate @bind-Value="@fromDate" id="fromDate" class="form-control" />
                </div>

                <div class="col-auto">
                    <label class="col-form-label">To</label>
                </div>
                <div class="col-auto">
                    <InputDate id="toDate" @bind-Value="@toDate" class="form-control" />
                </div>

                <div class="col-auto">
                    <button type="button" class="btn btn-primary" @onclick="@SearchClasses">Search Classes</button>
                </div>
            </div>

            <div class="row">
                <h4>Available Classes</h4>
                @if (classes == null)
                {
                    <p>Loading classes...</p>
                }
                else if (!classes.Any())
                {
                    <p>No classes found.</p>
                }
                else
                {
                    <p>Number of classes found: @classes.Count</p>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Price</th>
                                    <th>Date</th>
                                    <th>Capacity</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cls in classes)
                                {
                                    <tr>
                                        <td>@cls.Name</td>
                                        <td>@cls.Price</td>
                                        <td>@cls.Date.ToString("g")</td>
                                        <td>@cls.Capacity</td>
                                        <td>
                                            <button class="btn btn-sm btn-success" @onclick="@(() => AddClass(cls))">Add</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Plan Cart Section -->
        <div class="col-md-3 border-start">
            <h4>Selected Classes</h4>
            @if (plan.SelectedClasses.Any())
            {
                <ul class="list-group mb-3">
                    @foreach (var item in plan.SelectedClasses)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <h6>@item.Name</h6>
                                <small class="text-muted">@item.Price €</small>
                            </div>
                            <button class="btn btn-sm btn-danger" @onclick="@(() => RemoveClass(item))">X</button>
                        </li>
                    }
                </ul>
                <p><b>Total:</b> @plan.SelectedClasses.Sum(x => x.Price) €</p>
                <a href="/plan/createplan" class="btn btn-primary w-100">Proceed to Plan</a>
            }
            else
            {
                <p class="text-muted">No classes selected.</p>
            }
        </div>
    </div>
</div>

@code {
    private ICollection<AppForSEII2526.Web.API.ClassForPlanDTO> classes;

    private bool hideErrors => string.IsNullOrEmpty(errors);
    private string errors = "";

    private string itemTypes { get; set; } = "";
    private DateTime date { get; set; } = DateTime.Today;

    private DateTime _fromDate = DateTime.Today;
    private DateTime fromDate
    {
        get { return _fromDate; }
        set { _fromDate = value; }
    }

    private DateTime _toDate = DateTime.Today.AddDays(7);
    private DateTime toDate
    {
        get { return _toDate; }
        set { _toDate = value; }
    }

    private AppForSEII2526.API.DTOs.ClassesDTOs.PlanForCreateDTO plan => planState.Plan;

    private void AddClass(AppForSEII2526.Web.API.ClassForPlanDTO clientClassDto)
    {
        planState.AddClassToPlan(clientClassDto);
    }

    private void RemoveClass(AppForSEII2526.API.DTOs.ClassesDTOs.ClassSelectionDTO item)
    {
        planState.RemovePlanItem(item);
    }

    public async Task SearchClasses()
    {
        errors = "";
        try
        {
            var typesList = string.IsNullOrWhiteSpace(itemTypes)? null: new List<string> { itemTypes };


            var classes2 = await apiclient.GetClassForPlanAsync(typesList, date, fromDate, toDate);
        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex.Message}");
            if (ex.StatusCode == 400)
            {
                errors = $"Bad Request (400): {ex.Message}";
            }
            else
            {
                errors = $"Error connecting to system ({ex.StatusCode}): {ex.Message}";
            }
        }
        catch (Exception ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = $"Unexpected error: {ex.Message}";
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await SearchClasses();
    }
}