@page "/purchase/selectitemsforpurchase"

@using AppForSEII2526.Web.API
@inject AppForKairosAPIClient apiclient
@inject ILogger<SelectItemsForPurchase> logger   
@inject PurchaseStateContainer purchaseState
@inject NavigationManager navigation

<h3>SelectItemsForPurchase</h3>

<div class="container-fluid">
    <div class="row alert alert-danger" hidden = "@hideErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Name</span>
                        <input type="text" id="inputName" @bind=itemName class="form-control" placeholder="Name" aria-label="Name" aria-describedby="basic-addon1">
                    </div>
                </div>

                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Brand</span>
                        <input type="text" id="inputBrand" @bind=itemBrand class="form-control" placeholder="Brand" aria-label="Brand" aria-describedby="basic-addon1">
                    </div>
                </div>

                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@SearchItem id="searchItems">Search items</button>
                </div>
            </div>
            <div class="row">
                @if (items == null)
                {
                    <p> Loading items....</p>
                }
                else
                {
                    <p> Number of items @items.Count</p>
                }

            </div>
        </div>
        <div class="col-2" hidden="@hideRentingCart">
                <div class="row">
                    <h3> Shopping Cart</h3>
                </div>
            @foreach (var item in itemToCreate.PurchaseItems)
            {
                <div class="row">
                    <button type="button" class="btn btn-light" id="removeItem_@item.ItemId" @onclick="@(() => RemoveItem(item.ItemId))">x @item.ItemId - @item.Quantity€</button>
                </div>
            }
            <div class="row">
                <button type="button" class=" btn btn-primary" id="purchaseItemButton" @onclick="PurchaseItem">Purchase Item </button>
            </div>
        </div>

    </div>
    
</div>

@code {
    private bool hideRentingCart { get { return hiddenPurchaseCart; } }
    private ICollection<ItemForPurchaseDTO> items;
    private bool hideErrors {get{ return errors.Length == 0; }}
    private string errors = "";
    private string itemName { get; set; }
    private string itemBrand { get; set; }
    private DateTime _from;
    private DateTime _to;


    private ItemForCreateDTO itemToCreate => purchaseState.Purchase;

    private bool hiddenPurchaseCart = true;

    private void AddItem(ItemForPurchaseDTO item)
    {
        purchaseState.AddPurchaseItem(item);
    }

    private void RemoveItem(int item)
    {
         purchaseState.RemovePurchaseItem(item);

        if(purchaseState.Purchase.PurchaseItems.Count == 0)
        {
            hiddenPurchaseCart = true;
        }
    }
        private void PurchaseItem()
        {
            navigation.NavigateTo("/item/createrental");
        }

    public async void SearchItem()
    {
        try
        {
            items = await apiclient.GetItemsForPurchaseAsync(itemName, itemBrand);


        }catch(ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error while connecting to the system";
        }
    }
    protected override Task OnInitializedAsync()
    {
        //the type of PurchaseDateFrom is DateTimeOffset, it is required a conversion
        //https://learn.microsoft.com/es-es/dotnet/standard/datetime/converting-between-datetime-and-offset
        _from = (_from == new DateTime(1, 1, 1)) ?
            DateTime.SpecifyKind(DateTime.Today.AddDays(1), DateTimeKind.Utc)
            : _from;


        //the type of PurchaseDateFrom is DateTimeOffset, it is required a conversion
        //https://learn.microsoft.com/es-es/dotnet/standard/datetime/converting-between-datetime-and-offset
        _to = (_to == new DateTime(1, 1, 1)) ?
            DateTime.SpecifyKind(DateTime.Today.AddDays(2), DateTimeKind.Utc)
            : _to;

        SearchItem();

        return base.OnInitializedAsync();
    }
}
