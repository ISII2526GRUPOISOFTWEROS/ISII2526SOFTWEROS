@page "/purchase/detail"

@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AppForKairosAPIClient apiclient

<h3>Purchase Detail</h3>

@attribute [Authorize]

@if(purchaseDetail != null)
{
    <p>@errorMessage</p>
}
else
{
    <table class="table table-borderless table-sm">
        <tr>
            <th>Purchase Id</th>
            <td id="NameSurname">@purchaseDetail.Id</td>
        </tr>
        <tr>
            <th>Purchase Item</th>
            <td id="NameSurname">@purchaseDetail.PurchaseItems</td>
        </tr>
        <tr>
            <th>Description</th>
            <td id="NameSurname">@purchaseDetail.Description</td>
        </tr>
        
        <tr>
            <th>Total price</th>
            <td id="NameSurname">@purchaseDetail.TotalPrice</td>
        </tr>
        <tr>
            <th>Delivery Address</th>
            <td id="DeliveryAddress">@purchaseDetail.DeliveryAddress</td>
        </tr>
        <tr>
            <th>Payment Method</th>
            <td id="PaymentMethod">@purchaseDetail.PaymentMethod</td>
        </tr>

        <h4>Purchased Items</h4>

        <table class="table" id="PurchaseItems">
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Purchase item</th>
                    <th scope="col">Delivery address</th>
                    <th scope="col">Price for purchase</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (PurchasedItemDTO item in purchaseDetail.PurchaseItems)
                {
                    <tr id="RentalItem_@item.Name">
                        <td>@item.Brand</td>
                        <td>@item.Quantity</td>
                        <td>@item.Price €</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @*colspan is used to state that TWO columns are collapsed*@
            <th scope="row" colspan="2" class="text-end">Total Price</th>
            <td id="TotalPrice">@purchaseDetail.TotalPrice €</td>
            </tfoot>

        </table>





    </table>
    
}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int PurchaseId { get; set; }
    private PurchaseDetailDTO purchaseDetail;
    private string errorMessage = "";

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        string userName = "";
        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated && user.IsInRole("User"))
                {
                    userName = user.Identity.Name;
                }

            }
        }
        try
        {
            //purchaseDetail = await apiclient.GetPurchaseDetailsAsync(PurchaseId);
        }
        catch (Exception ex)
        {
            purchaseDetail = null;
        }
        if ((purchaseDetail == null) /* ||  (purchaseDetail.User != userName) */ )
        {
            errorMessage = $"Error! You are not authorized to see this purchase or there is not a purchase with id {PurchaseId}."; 
        }
    }

}
