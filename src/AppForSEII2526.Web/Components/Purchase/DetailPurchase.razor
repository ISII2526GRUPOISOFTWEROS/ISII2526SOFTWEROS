@page "/purchase/detail"

@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AppForKairosAPIClient apiclient
@inject PurchaseStateContainer purchaseStateContainer

<h3>Purchase Detail</h3>

@attribute [Authorize]

@if (purchaseDetail == null)
{
    <p>@errorMessage</p>
}
else
{
    <table class="table table-borderless table-sm">
        <tr>
            <th>Purchase Id</th>
            <td id="PurchaseId">@purchaseDetail.Id</td>
        </tr>
        <tr>
            <th>Delivery Address</th>
            <td id="DeliveryAddress">@purchaseDetail.DeliveryAddress</td>
        </tr>
        <tr>
            <th>Total price</th>
            <td id="TotalPriceHeader">@purchaseDetail.TotalPrice €</td>
        </tr>
        <tr>
            <th>Description</th>
            <td id="Description">@purchaseDetail.Description</td>
        </tr>
        <tr>
            <th>Payment Method</th>
            <td id="PaymentMethod">@purchaseDetail.PaymentMethod</td>
        </tr>
    </table>
        <h4>Purchased Items</h4>

        <table class="table" id="PurchaseItems">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Brand</th>
                    <th scope="col">Quantity</th>
                    <th scope="col">Price</th>
                </tr>
            </thead>
        
            <tbody>
                @foreach (PurchasedItemDTO item in purchaseDetail.PurchaseItems)
                {
                    <tr id="PurchaseItem_@item.Name">
                        <td>@item.Name</td>
                        <td>@item.Brand</td>
                        <td>@item.Quantity</td>
                        <td>@item.Price €</td>
                    </tr>
                }
            </tbody>
            <tfoot>
               <tr>
                    <th scope="row" colspan="3" class="text-end">Total Price</th>
                    <td id="TotalPriceFooter">@purchaseDetail.TotalPrice €</td>
            </tr>
            </tfoot>    
    </table>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int PurchaseId { get; set; }
    private PurchaseDetailDTO purchaseDetail;
    private string errorMessage = "Loading ...";
    private string currentUserName ;

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        string userName = "";
        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated && user.IsInRole("User"))
                {
                    currentUserName = user.Identity.Name;
                }

            }
        }
        try
        {
            var purchases = await apiclient.GetPurchaseDetailsAsync(PurchaseId);
            purchaseDetail = purchases?.FirstOrDefault();
        }
        catch (Exception ex)
        {
            purchaseDetail = null;
        }
        if(purchaseDetail == null)
        {
            errorMessage = $"Error! There is not a purchase with id {PurchaseId}.";
        } 
        else {
            if ((string.IsNullOrEmpty(currentUserName)) || (purchaseDetail.Username != currentUserName))
        {
                purchaseDetail = null;
            errorMessage = $"Error! You are not authorized to see this purchase or there is not a purchase with id {PurchaseId}."; 
        }
    }
    }

}
